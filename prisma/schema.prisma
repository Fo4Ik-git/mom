generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum BanReason {
  ACCESS_EXPIRED
}

enum AccessExpiryCheckInterval {
  OFF
  DAILY
  WEEKLY
  MONTHLY
}

/// REGISTRATION — invite to sign up; REFERRAL — future referral campaigns (same redemption flow)
enum AccessKeyKind {
  REGISTRATION
  REFERRAL
}

enum CalculatorShareRole {
  VIEW
  EDIT
}

enum AiAccessMode {
  OFF
  PERMANENT
  UNTIL_DATE
  DURATION
}

enum AiTokenQuotaPeriod {
  DAY
  WEEK
  MONTH
}

model PlatformSettings {
  id                    String   @id @default("default")
  defaultMaxCalculators Int      @default(5)
  /// Default access period for new users (via invite key or admin create without date)
  defaultAccessDays     Int      @default(30)
  /// Days added to referrer access when someone signs up via their link; 0 = disabled
  defaultReferrerBonusDays Int   @default(0)
  supportEmail          String?
  supportTelegram       String?
  /// Auto-ban users with expired access (manual run or scheduled)
  accessExpiryCheckInterval   AccessExpiryCheckInterval @default(OFF)
  accessExpiryCheckLastRunAt  DateTime?
  /// Default token quota for users when AI access is granted (null = unlimited)
  defaultAiTokenQuota         Int?
  defaultAiTokenQuotaPeriod   AiTokenQuotaPeriod @default(MONTH)
  updatedAt             DateTime @updatedAt
}

model AccessKey {
  id             String          @id @default(cuid())
  code           String          @unique
  kind           AccessKeyKind   @default(REGISTRATION)
  label          String?
  maxUses        Int?
  usedCount      Int             @default(0)
  expiresAt      DateTime?
  /// Override access duration in days; null = PlatformSettings.defaultAccessDays; 0 = unlimited access
  accessDays     Int?
  /// Days added to referrer per signup; null = platform default; 0 = no bonus
  referrerBonusDays Int?
  active         Boolean         @default(true)
  referrerUserId String?
  referrerUser   User?           @relation("ReferralKeys", fields: [referrerUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  redemptions    AccessKeyRedemption[]

  @@index([kind, active])
  @@index([referrerUserId])
}

model AccessKeyRedemption {
  id          String    @id @default(cuid())
  accessKeyId String
  accessKey   AccessKey @relation(fields: [accessKeyId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([accessKeyId, userId])
  @@index([accessKeyId])
  @@index([userId])
}

model User {
  id                String       @id @default(cuid())
  name              String?
  email             String       @unique
  emailVerified     DateTime?
  passwordHash      String?
  image             String?
  role              Role         @default(USER)
  banned            Boolean      @default(false)
  banReason         BanReason?
  /// Per-user cap; null = use PlatformSettings.defaultMaxCalculators
  maxCalculators    Int?
  /// When set and in the past, user cannot use builder (admins exempt)
  accessExpiresAt   DateTime?
  /// Admin dismissed ban alert while user remains banned
  issueBanDismissedAt DateTime?
  /// accessExpiresAt value when admin dismissed expired-access alert
  issueExpiredDismissedFor DateTime?
  adminNotes        String?
  /// AI assistant access (admins always have access regardless of mode)
  aiAccessMode           AiAccessMode        @default(OFF)
  /// For UNTIL_DATE: access ends at this instant
  aiAccessExpiresAt      DateTime?
  /// For DURATION: grant start (set when admin enables duration mode)
  aiAccessGrantedAt      DateTime?
  /// For DURATION: days from aiAccessGrantedAt
  aiAccessDurationDays   Int?
  /// Per-user token cap per period; null = unlimited
  aiTokenQuota           Int?
  aiTokenQuotaPeriod     AiTokenQuotaPeriod  @default(MONTH)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  accounts          Account[]
  aiTokenUsages     AiTokenUsage[]
  aiChatThreads     AiChatThread[]
  sessions          Session[]
  calculators          Calculator[]
  calculatorShares     CalculatorShare[]
  referralKeys         AccessKey[]           @relation("ReferralKeys")
  accessKeyRedemptions AccessKeyRedemption[]
}

model Calculator {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  slug        String   @unique
  config      String
  isPublic    Boolean  @default(false)
  isTemplate  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shares      CalculatorShare[]
  aiChatThreads AiChatThread[]

  @@index([userId])
}

model AiChatThread {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  calculatorId String
  calculator   Calculator @relation(fields: [calculatorId], references: [id], onDelete: Cascade)
  messages     AiChatMessage[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, calculatorId])
  @@index([calculatorId])
}

model AiChatMessage {
  id        String   @id @default(cuid())
  threadId  String
  thread    AiChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String
  content   String
  sortOrder Int
  createdAt DateTime @default(now())

  @@index([threadId, sortOrder])
}

model CalculatorShare {
  id           String              @id @default(cuid())
  calculatorId String
  calculator   Calculator          @relation(fields: [calculatorId], references: [id], onDelete: Cascade)
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         CalculatorShareRole @default(EDIT)
  createdAt    DateTime            @default(now())

  @@unique([calculatorId, userId])
  @@index([calculatorId])
  @@index([userId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model AiTokenUsage {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  calculatorId     String?
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}
